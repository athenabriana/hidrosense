# Copie para .env e preencha. NUNCA versione o .env.
# Gere valores fortes, ex.: openssl rand -base64 48
# Uso local (docker compose). Em staging/produção os valores vêm dos secrets dos GitHub Environments.

ASPNETCORE_ENVIRONMENT=Development
API_PORT=8080

# SQL Server (senha do usuário sa: 8+ caracteres com maiúscula, minúscula, número e símbolo)
DB_NAME=HidroSense
DB_PASSWORD=

# Chave de assinatura JWT (mínimo 32 caracteres)
JWT_SECRET_KEY=

# Senhas dos usuários criados no primeiro start (admin e operator)
SEED_ADMIN_PASSWORD=
SEED_OPERATOR_PASSWORD=
