{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "ValidationProblemDetails (400 do FluentValidation + [ApiController])",
  "type": "object",
  "required": ["title", "status", "errors"],
  "properties": {
    "type": { "type": "string" },
    "title": { "type": "string" },
    "status": { "type": "integer", "enum": [400] },
    "traceId": { "type": "string" },
    "errors": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string" }
      }
    }
  }
}
